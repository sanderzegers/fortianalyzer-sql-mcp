# Copy to .env and fill in. .env is git-ignored; never commit it.

# Base URL of the FortiAnalyzer (required)
FAZ_HOST=https://faz.example.com
# Account name (required). A dedicated account with report viewer + run report rights is recommended
FAZ_USER=svc-claude
# Password (the command-line client prompts for it if unset)
FAZ_PASSWORD=
# ADOM to work in, by name. Default: the account's default ADOM (usually root)
FAZ_ADOM=root

# Numeric ADOM id. Optional shortcut that skips the ADOM lookup
# FAZ_ADOM_OID=
# PEM file with the CA that signed the FortiAnalyzer certificate
# FAZ_CA_BUNDLE=
# 1 disables TLS verification (self-signed lab certificates only)
# FAZ_INSECURE=1
# Seconds of inactivity before the session is closed. Default 300, 0 = never
# FAZ_IDLE_LOGOUT=300
# Seconds before a running query is cancelled. Default 1800
# FAZ_JOB_TIMEOUT=1800
# Queries allowed to run at the same time; further ones wait in a queue. Default 2
# FAZ_MAX_JOBS=2
# Queued queries before new ones are rejected. Default 8
# FAZ_MAX_QUEUED=8
# Longest wait of one tool call in seconds; keep it below the MCP client's request timeout. Default 45
# FAZ_MAX_WAIT=45
